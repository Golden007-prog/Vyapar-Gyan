{
  "mcpServers": {
    "fetch": {
      "command": "uvx",
      "args": [
        "mcp-server-fetch"
      ],
      "env": {},
      "disabled": true,
      "autoApprove": []
    },
    "aws-iac": {
      "command": "uvx",
      "args": [
        "awslabs.aws-iac-mcp-server@latest"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "disabled": false,
      "autoApprove": []
    },
    "commerce-ops-mcp": {
      "command": "node",
      "args": [
        "./tools/mcp/commerce-ops/dist/index.js"
      ],
      "env": {
        "AWS_REGION": "ap-south-1",
        "AWS_PROFILE": "default",
        "APP_ENV": "dev",
        "DDB_TABLE_NAME": "dev-vyapargyan-main",
        "LOG_GROUP_PREFIX": "/aws/commerce"
      },
      "disabled": false,
      "autoApprove": [
        "get_order",
        "get_order_timeline",
        "get_payment",
        "get_inventory",
        "get_whatsapp_session",
        "list_seller_orders",
        "search_logs"
      ]
    },
    "commerce-catalog-mcp": {
      "command": "node",
      "args": [
        "./tools/mcp/commerce-catalog/dist/index.js"
      ],
      "env": {
        "AWS_REGION": "ap-south-1",
        "AWS_PROFILE": "default",
        "DYNAMODB_TABLE_NAME": "dev-vyapargyan-main",
        "S3_MEDIA_BUCKET": "commerce-media-dev"
      },
      "disabled": false,
      "autoApprove": [
        "get_product",
        "list_products_by_seller",
        "list_products_by_category",
        "get_category",
        "list_low_stock_products",
        "get_product_media"
      ]
    },
    "commerce-admin-mcp": {
      "command": "node",
      "args": [
        "./tools/mcp/commerce-admin/dist/index.js"
      ],
      "env": {
        "AWS_REGION": "ap-south-1",
        "AWS_PROFILE": "default",
        "DYNAMODB_TABLE_NAME": "dev-vyapargyan-main",
        "S3_DOC_BUCKET": "commerce-docs-dev"
      },
      "disabled": false,
      "autoApprove": [
        "list_pending_seller_approvals",
        "get_seller_profile",
        "list_open_disputes",
        "get_dispute",
        "get_audit_timeline",
        "list_recent_payments"
      ]
    },
    "twilio-mcp": {
      "command": "node",
      "args": [
        "./tools/mcp/twilio-mcp/dist/index.js"
      ],
      "env": {
        "TWILIO_ACCOUNT_SID": "${TWILIO_ACCOUNT_SID}",
        "TWILIO_AUTH_TOKEN": "${TWILIO_AUTH_TOKEN}",
        "TWILIO_PHONE_NUMBER": "${TWILIO_PHONE_NUMBER}"
      },
      "disabled": false,
      "autoApprove": [
        "get_message_history",
        "get_message_status",
        "send_whatsapp_message"
      ]
    }
  }
}