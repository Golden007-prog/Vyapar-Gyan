{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Test-specific settings
    "types": ["jest", "node"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/__tests__/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "cdk.out"
  ]
}
