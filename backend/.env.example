# --- AWS Configuration (REQUIRED) ---
AWS_REGION=ap-south-1
AWS_PROFILE=default
DDB_TABLE_NAME=CommerceCore-dev
S3_MEDIA_BUCKET=vyapargyan-dev-product-images
S3_DOC_BUCKET=vyapargyan-dev-documents
LOG_GROUP_PREFIX=/aws/commerce

# --- Twilio WhatsApp API (optional for initial boot) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Razorpay (optional for initial boot) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- AI Services ---
# Google Gemini API for OCR, voice transcription, and market analysis
# Get your API key from: https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here

# xAI Grok API for market trend research and dynamic pricing
# Get your API key from: https://x.ai/
GROK_API_KEY=your_grok_api_key_here

# --- App ---
APP_NAME=VyaparGyan
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
LOG_LEVEL=INFO
