{
  "name": "vyapargyan",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered commerce platform for local Indian retailers",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "cdk:synth": "pnpm --filter @vyapargyan/infra cdk synth",
    "cdk:deploy": "pnpm --filter @vyapargyan/infra cdk deploy",
    "cdk:diff": "pnpm --filter @vyapargyan/infra cdk diff",
    "cdk:destroy": "pnpm --filter @vyapargyan/infra cdk destroy"
  },
  "keywords": [
    "commerce",
    "whatsapp",
    "serverless",
    "aws",
    "cdk"
  ],
  "author": "VyaparGyan Team",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3"
  }
}
